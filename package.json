{
  "name": "statics-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sync-abis": "node scripts/sync-abis.mjs",
    "check:abis": "node scripts/sync-abis.mjs --check",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:source": "node scripts/check-source-drift.mjs",
    "verify": "npm run check:links && npm run typecheck && npm run build",
    "postbuild": "pagefind --site out && node scripts/generate-agent-output.mjs"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "pagefind": "^1.5.2",
    "typescript": "^5.8.3"
  }
}
